{
  "name": "naitmor-archive-2-0",
  "version": "0.1.0",
  "private": true,
  "description": "Official NAITMOR Dark Fantasy Universe & Music Portal",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "npm run check:content",
    "check": "npm run check:content && npm run test:content && astro check",
    "check:content": "node scripts/check-content.ts",
    "test:content": "node --test scripts/content.test.ts",
    "typecheck": "npm run check",
    "prebuild": "npm run check:content",
    "build": "astro build",
    "check:pages": "node scripts/check-pages.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.5",
    "astro": "7.4.11",
    "github-slugger": "2.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  }
}
